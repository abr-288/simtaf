# Menewa (zone de dev) — à ajouter au Caddyfile partagé (/srv/proxy/Caddyfile).
# __SAAS_HOST__ et __ADMIN_HOST__ sont remplacés par deploy.sh. Sites ouverts sans mot de passe d'accès (choix du 2026-11-23).
__SAAS_HOST__ {
	header {
		-Server
		X-Robots-Tag "noindex, nofollow"
	}
	request_body {
		max_size 12MB
	}
	reverse_proxy menewa-saas:3000
}

__ADMIN_HOST__ {
	header {
		-Server
		X-Robots-Tag "noindex, nofollow"
	}
	request_body {
		max_size 12MB
	}
	reverse_proxy menewa-admin:3001
}
