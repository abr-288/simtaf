# Applications
NEXT_PUBLIC_API_URL=http://localhost:8080/api
API_BASE_URL=http://localhost:8080/api
API_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/menewa
DATABASE_USERNAME=menewa
DATABASE_PASSWORD=change-me
OTP_DEV_MODE=true
OTP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
IDENTITY_BOOTSTRAP_ADMIN_PHONE=+22890000001
IDENTITY_BOOTSTRAP_ADMIN_NAME=Administrateur Menewa
# Envoi des codes OTP et des SMS. En production : OTP_DEV_MODE=false, SMS_PROVIDER=twilio et les identifiants Twilio.
# Avec OTP_DEV_MODE=true, le code s'affiche à l'écran et aucun SMS n'est envoyé.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Expéditeur : numéro Twilio (+1…) ou identifiant alphanumérique (MenewaNaya par défaut), ou bien un Messaging Service (MG…)
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Numéros de démonstration dont le code reste affiché, sans SMS (séparés par des virgules). Vide en production.
OTP_TEST_PHONES=
# Paiement Mobile Money en ligne : « simulated » tant qu'aucun agrégateur n'est branché (aucun argent ne circule).
PAYMENT_PROVIDER=simulated
PAYMENT_WEBHOOK_SECRET=
# Autre possibilité : passerelle HTTP JSON {to, message, sender} (SMS_PROVIDER=http)
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
CATALOG_SEED_DEMO_DATA=true
# Dossier privé des fichiers (preuves, reçus, pièces de litige), hors webroot
STORAGE_DIR=./storage
# URL de la console d'administration (redirection des comptes admin qui ouvrent le SaaS)
ADMIN_APP_URL=http://localhost:3001
